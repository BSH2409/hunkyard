{
  "name": "hunkyard",
  "private": true,
  "dependencies": {
    "@pierre/diffs": "1.6.4",
    "@sanity/diff-match-patch": "3.2.1",
    "@zumer/snapdom": "3.7.6",
    "dompurify": "3.5.0",
    "gemoji": "8.1.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "mermaid": "12.3.0"
  },
  "scripts": {
    "update-deps": "node copy-deps.js",
    "record-assets": "node scripts/record-vendored-assets.mjs",
    "verify-assets": "node scripts/verify-vendored-assets.mjs",
    "verify-assets:installed": "node scripts/verify-vendored-assets.mjs --installed",
    "verify-assets:npm": "node scripts/verify-vendored-assets.mjs --npm",
    "test:frontend": "node --test web/__tests__/*.test.js",
    "test:perf": "node --test web/__tests__/perf/*.perf.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "shiki": "4.6.0",
    "stylelint": "18.0.0"
  }
}
